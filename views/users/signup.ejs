<% layout('layouts/boilerplate') -%>

<div class="row mt-3">
    <h1 class="col-6 offset-3">SignUp on Wanderer</h1>
    <div class="col-6 offset-3">
        <form action="/signup" method="POST" class="needs-validation" novalidate>
            <div class="mb-3">
                <label for="username" class="from-label">Username</label>
                <input type="text" name="username" id="username" placeholder="Add Your username" class="form-control" required>
                <div class="valid-feedback">username looks good</div>
                <div class="invalid-feedback">Enter your Username</div>
            </div> 
            <div class="mb-3">
                <label for="email" class="from-label">Email</label>
                <input type="email" name="email" id="email" placeholder="Add Your email" class="form-control" required>
                <div class="invalid-feedback">Enter your email</div>
            </div> 

            <div class="mb-3">
                <label for="password" class="from-label">Password</label>
                <input type="password" name="password" id="password"  class="form-control" required>
                <div class="invalid-feedback">Enter your password</div>
            </div> 
            <button class="btn btn-success">SignUp</button>
        </form>
    </div>
</div>