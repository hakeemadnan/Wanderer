<% layout('layouts/boilerplate') -%>
<body>
    <div class="row mt-3">
        <div class="col-8 offset-2">
        <h4>Update your listing</h4>
        <form method="POST" action="/listings/<%=listing._id%>?_method=PUT" novalidate class="needs-validation">
            <div class="mb-3">
                <label for="title" class="from-label">Title</label>
                <input class="form-control" type="text" name="listing[title]" value="<%= listing.title%>" required>
                <div class="invalid-feedback">Enter your Title</div>
        
            </div>
            <div class="mb-3">
                <label for="description" class="from-label">Description</label>
                <textarea class="form-control" row="10" cols="50" type="text" name="listing[description]" required ><%= listing.description%></textarea>
                <div class="invalid-feedback">Enter a short description</div>
            </div>
            <div class="mb-3">
                <label for="image" class="from-label">Image Link</label>
                <input class="form-control" type="text" name="listing[image]" value="<%= listing.image%>" required>
                <div class="invalid-feedback">Enter a valid url</div>
            </div>
            
            <div class="row">
                <div class="mb-3 col-md-4">
                    <label for="price" class="from-label">Price</label>
                    <input class="form-control" type="number" name="listing[price]" value="<%= listing.price%>" required>
                    <div class="invalid-feedback">Enter a Valid price</div>
                    
                </div>
                
                <div class="mb-3 col-md-8">
                    <label for="country" class="from-label">Country</label>
                    <input class="form-control" type="text" name="listing[country]" value="<%= listing.country%>" required>
                    <div class="invalid-feedback">Enter a valid country name</div>

                </div>
            </div>
        
            <div class="mb-3">
                <label for="location" class="from-label">Location</label>
                <input  class="form-control" type="text" name="listing[location]" value="<%= listing.location%>" required>
                <div class="invalid-feedback">Enter a valid location</div>

            </div>
            
        
            <button class="btn btn-dark edit-btn mt-3">Edit</button>
        </form>
     </div>
    </div>
</body>
